{
  "name": "artenmonster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Artenmonster - Tier-Ratespiel auf Basis des biologischen Stammbaums (React + Vite + PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:ncbi": "tsx tools/1-fetch-ncbi.ts",
    "data:wikidata": "tsx tools/2-fetch-wikidata.ts",
    "data:enrich": "tsx tools/3-enrich.ts",
    "data:tree": "tsx tools/4-build-tree.ts",
    "data:emit": "tsx tools/5-emit.ts",
    "data:all": "npm run data:ncbi && npm run data:wikidata && npm run data:enrich && npm run data:tree && npm run data:emit",
    "icons": "node scripts/gen-icons.mjs",
    "data:gruppen": "tsx tools/gruppen-analyse.ts",
    "data:stufen": "tsx tools/stufen-check.ts"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "dexie": "^4.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "^3.6.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^15.11.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tar": "^7.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "workbox-window": "^7.3.0",
    "sharp": "^0.35.3"
  }
}
